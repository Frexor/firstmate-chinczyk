{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.cjs fm-sessionstart-run.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.cjs fm-arm-pretool-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.cjs fm-cd-pretool-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/fm-codex-hook.cjs fm-turnend-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
